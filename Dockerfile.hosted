# Build with something like:
#  docker build -f ./Dockerfile.hosted --platform=linux/amd64 .
# The FROM line below sets the Keycloak server version. Move it together with
# KEYCLOAK_VERSION in ol-infrastructure (src/bridge/lib/versions.py), which
# picks the CAS and SCIM plugin jars for the build.
FROM quay.io/keycloak/keycloak:26.8@sha256:7e66a96e4739239070aeaf72e4c5decf0f7f682cfc725b9f7ea2b336eaba38b3

# COPY ol-keycloak/ol-spi/ /opt/keycloak/providers/
COPY plugins/*.jar /opt/keycloak/providers/
# scim-api is on by default from 26.8 and registers a realm-restapi-extension
# factory with the id `scim`, the same id scim-for-keycloak uses. Keycloak
# already prefers the plugin's factory, so /realms/<realm>/scim is the
# plugin's either way. Disabling the feature removes the built-in SCIM
# resource providers and the realm "SCIM API" switch, which would otherwise
# sit in the admin console controlling an endpoint that is not served.
#
# 26.8.2 makes the Admin REST API reject tokens without the kc-admin-api scope
# (CVE-2026-19688). That scope is created by the 26.8.2 migration, so our
# service-account clients can only be given it after Production upgrades.
# Turning the check off until then keeps their Admin API calls working. Keycloak
# treats this option as build-time (its name ends in "-enabled"), so it has to
# be set here: an optimized start exits if the runtime value differs from the
# built one, which also means re-enabling the check needs a rebuilt image. CI
# starts non-optimized and rebuilds without it, so CI still enforces the check.
# Remove this line once every client that calls the Admin API gets tokens that
# carry kc-admin-api. Having the scope assigned is not enough for clients that
# have it as an optional scope; those apps must also request it.
RUN /opt/keycloak/bin/kc.sh build \
    --db=postgres \
    --health-enabled=true \
    --metrics-enabled=true \
    --event-metrics-user-enabled=true \
    --spi-login--provider=ol-freemarker \
    --tracing-enabled=true \
    --tracing-jdbc-enabled=true \
    --features=update-email \
    --features-disabled=scim-api \
    --spi-admin--audience-check-enabled=false

# All env vars for hosted instances should be specified in
# .env in the ol-infrastructure repo.

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
