# Build with something like:
#  docker build -f ./Dockerfile.hosted --platform=linux/amd64 .
# The FROM line below sets the Keycloak server version. Move it together with
# KEYCLOAK_VERSION in ol-infrastructure (src/bridge/lib/versions.py), which
# picks the CAS and SCIM plugin jars for the build.
FROM quay.io/keycloak/keycloak:26.8@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244

# COPY ol-keycloak/ol-spi/ /opt/keycloak/providers/
COPY plugins/*.jar /opt/keycloak/providers/
# scim-api is on by default from 26.8 and registers a realm-restapi-extension
# factory with the id `scim`, the same id scim-for-keycloak uses. Keycloak
# already prefers the plugin's factory, so /realms/<realm>/scim is the
# plugin's either way. Disabling the feature removes the built-in SCIM
# resource providers and the realm "SCIM API" switch, which would otherwise
# sit in the admin console controlling an endpoint that is not served.
RUN /opt/keycloak/bin/kc.sh build \
    --db=postgres \
    --health-enabled=true \
    --metrics-enabled=true \
    --event-metrics-user-enabled=true \
    --spi-login--provider=ol-freemarker \
    --tracing-enabled=true \
    --tracing-jdbc-enabled=true \
    --features=update-email \
    --features-disabled=scim-api

# All env vars for hosted instances should be specified in
# .env in the ol-infrastructure repo.

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
